{
  "name": "plz-vscode",
  "displayName": "Please",
  "description": "Integrations for the Please build system",
  "author": "peter.ebden@gmail.com",
  "license": "Apache-2.0",
  "icon": "plz_128.png",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thought-machine/please-vscode"
  },
  "bugs": {
    "url": "https://github.com/thought-machine/please-vscode/issues"
  },
  "publisher": "please-build",
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [],
  "engines": {
    "vscode": "^1.52.0"
  },
  "activationEvents": [
    "workspaceContains:.plzconfig"
  ],
  "main": "./out/src/main",
  "contributes": {
    "configuration": {
      "type": "object",
      "properties": {
        "plz.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Please Language Server."
        },
        "please": {
          "type": "object",
          "default": {},
          "description": "User-defined code lenses for specific Please rule names.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code_lens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "The title of the code lens."
                    },
                    "command": {
                      "type": "string",
                      "description": "The command to run (e.g. 'plz run', 'plz test', or any VS Code command)."
                    },
                    "postfix_target": {
                      "type": "string",
                      "description": "An optional postfix to append to the target name (e.g. '_with_dev_ff')."
                    },
                    "postfixTarget": {
                      "type": "string",
                      "description": "An optional postfix to append to the target name (e.g. '_with_dev_ff')."
                    },
                    "terminal": {
                      "type": "boolean",
                      "description": "An optional override to force running this specific code lens in the Integrated Terminal (true) or background Output Channel (false)."
                    },
                    "Terminal": {
                      "type": "boolean",
                      "description": "An optional override to force running this specific code lens in the Integrated Terminal (true) or background Output Channel (false)."
                    },
                    "arguments": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Arguments to pass to the command. Supports referencing '${target}' or '$target'."
                    }
                  },
                  "required": [
                    "title",
                    "command"
                  ]
                }
              }
            }
          }
        },
        "please.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Whether to always run Please commands in the VS Code Integrated Terminal."
        }
      }
    },
    "languages": [
      {
        "id": "plz",
        "aliases": [
          "Please",
          "please"
        ],
        "filenames": [
          "BUILD"
        ],
        "extensions": [
          ".plz",
          ".build_defs",
          ".build"
        ],
        "configuration": "./syntax/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plz",
        "scopeName": "source.plz",
        "path": "./syntax/grammar.json"
      }
    ],
    "breakpoints": [
      {
        "language": "go"
      },
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "plz-go",
        "label": "Please Go",
        "program": "./out/src/languages/go/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "go"
        ]
      },
      {
        "type": "plz-python",
        "label": "Please Python",
        "languages": [
          "python"
        ]
      }
    ]
  },
  "configurationDefaults": {
    "[plz]": {
      "editor.insertSpaces": true,
      "editor.formatOnSave": true
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b && cp -R scripts/ out/",
    "watch": "tsc -b -w",
    "prettify": "prettier --write ."
  },
  "dependencies": {
    "clipboardy": "^2.3.0",
    "json-rpc2": "^2.0.0",
    "semver": "^7.5.2",
    "tree-kill": "file:third_party/tree-kill",
    "vscode-debugadapter": "^1.47.0",
    "vscode-debugprotocol": "^1.47.0",
    "vscode-languageclient": "^7.0.0",
    "vscode-languageserver-protocol": "^3.16.0"
  },
  "devDependencies": {
    "@types/node": "^15.0.1",
    "@types/semver": "^7.3.5",
    "@types/vscode": "^1.52.0",
    "prettier": "2.3.0",
    "typescript": "^4.2.4"
  }
}
